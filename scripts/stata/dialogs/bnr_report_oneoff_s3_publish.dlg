*! BNR one-off CVD report Step 3: publish approved payload
*! version 0.1.0, 2 September 2026
VERSION 19.0
POSITION . . 530 200

DIALOG main, label("BNR One-off Report. Step 3 - publish report")
BEGIN
  TEXTBOX tx_intro 15 15 500 52, label("Step 3 publishes the report.")
  GROUPBOX gb_report 15 82 500 70, label("Approved report")
  TEXT tx_study 30 111 90 ., label("Study ID:")
  EDIT ed_study 130 108 235 ., nomemory error("Study ID")
  TEXT tx_version 390 111 65 ., label("Version:")
  SPINNER ed_version 460 108 45 ., default(1) min(1) max(99) nomemory error("Report version")
  CHECKBOX ck_replace 30 170 460 ., default(0) nomemory label("Authorise replacement")
END

OK ok1, label("Run Step 3")
CANCEL cancel1, label("Cancel")
RESET reset1

PROGRAM command
BEGIN
  require main.ed_study
  put "do $BNR_STATA/reporting/bnr_report_oneoff_s3_publish.do "
  put main.ed_study
  put " "
  put main.ed_version
  if main.ck_replace {
    put " replace"
  }
END
