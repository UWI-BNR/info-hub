*! BNR rolling three-month CVD update builder
*! version 1.0.0, 2 September 2026
VERSION 19.0
POSITION . . 540 510

DIALOG main, label("BNR: Build rolling three-month CVD update")
BEGIN
  TEXTBOX tx_intro 15 15 510 54, label("Create one dated online update from exact public event and mortality releases. The resulting page must still be rendered and reviewed before it is committed or deployed.")

  GROUPBOX gb_report 15 86 510 70, label("Report period and version")
  TEXT tx_report_year 30 114 95 ., label("Report year:")
  SPINNER ed_report_year 130 111 75 ., default(2026) min(2024) max(2100) nomemory error("Report year")
  TEXT tx_report_month 230 114 105 ., label("Report month:")
  SPINNER ed_report_month 335 111 65 ., default(1) min(1) max(12) nomemory error("Report month")
  TEXT tx_version 415 114 50 ., label("Version:")
  SPINNER ed_version 465 111 45 ., default(1) min(1) max(99) nomemory error("Report version")

  GROUPBOX gb_event 15 172 510 70, label("Approved public CVD-event release")
  TEXT tx_event_year 30 200 95 ., label("Release year:")
  SPINNER ed_event_year 130 197 75 ., default(2026) min(2024) max(2100) nomemory error("Event release year")
  TEXT tx_event_month 230 200 105 ., label("Release month:")
  SPINNER ed_event_month 335 197 65 ., default(1) min(1) max(12) nomemory error("Event release month")

  GROUPBOX gb_mortality 15 258 510 70, label("Approved public mortality release")
  TEXT tx_mortality_year 30 286 95 ., label("Release year:")
  SPINNER ed_mortality_year 130 283 75 ., default(2026) min(2024) max(2100) nomemory error("Mortality release year")
  TEXT tx_mortality_month 230 286 105 ., label("Release month:")
  SPINNER ed_mortality_month 335 283 65 ., default(7) min(1) max(12) nomemory error("Mortality release month")

  GROUPBOX gb_protection 15 344 510 62, label("Version protection")
  CHECKBOX ck_replace 30 370 470 ., default(0) nomemory label("Publish a strictly higher version at this period's stable address")

  TEXTBOX tx_boundary 20 426 500 48, label("The builder uses the central QMD template and freezes complete copies of both declared public releases. It does not render, commit or deploy the website.")
END

OK ok1, label("Build update page")
CANCEL cancel1, label("Cancel")
RESET reset1

PROGRAM command
BEGIN
  put "do $BNR_STATA/reporting/bnr_report_update_build.do "
  put main.ed_report_year
  put " "
  put main.ed_report_month
  put " "
  put main.ed_event_year
  put " "
  put main.ed_event_month
  put " "
  put main.ed_mortality_year
  put " "
  put main.ed_mortality_month
  put " "
  put main.ed_version
  if main.ck_replace {
    put " replace"
  }
END
