*! BNR CVD Step 4: calculate and privately stage combined CVD metrics
VERSION 19.0
POSITION . . 470 400

DIALOG main, label("BNR Step 4: Calculate and stage combined CVD metrics")
BEGIN
  TEXTBOX tx_intro 15 15 440 38, label("Step 4 requires a CVD release and a completed mortality release. It remains private.")
  GROUPBOX gb_cvd 15 68 440 65, label("CVD release")
  TEXT tx_cvd_year 30 95 100 ., label("Year:")
  SPINNER ed_cvd_year 140 92 85 ., default(2024) min(2024) max(2100) nomemory error("CVD release year")
  TEXT tx_cvd_month 260 95 95 ., label("Month:")
  SPINNER ed_cvd_month 365 92 70 ., default(1) min(1) max(12) nomemory error("CVD release month")
  GROUPBOX gb_mort 15 148 440 65, label("Completed mortality release")
  TEXT tx_mort_year 30 175 100 ., label("Year:")
  SPINNER ed_mort_year 140 172 85 ., default(2026) min(2024) max(2100) nomemory error("Mortality release year")
  TEXT tx_mort_month 260 175 95 ., label("Month:")
  SPINNER ed_mort_month 365 172 70 ., default(1) min(1) max(12) nomemory error("Mortality release month")
  CHECKBOX ck_replace 20 235 430 ., default(0) nomemory label("Authorise replacement of the existing staging package")
  TEXTBOX tx_boundary 20 280 430 32, label("Step 4 calculates combined counts and annual rates. Step 5 performs disclosure review and approval.")
END

OK ok1, label("Run Step 4")
CANCEL cancel1, label("Cancel")
HELP help1, view("help bnr_step4_metrics")
RESET reset1

PROGRAM command
BEGIN
  require main.ed_cvd_year
  require main.ed_cvd_month
  require main.ed_mort_year
  require main.ed_mort_month
  put "do $BNR_STATA/monthly/bnr_step4_metrics.do "
  put main.ed_cvd_year
  put " "
  put main.ed_cvd_month
  put " "
  put main.ed_mort_year
  put " "
  put main.ed_mort_month
  if main.ck_replace {
    put " replace"
  }
END
