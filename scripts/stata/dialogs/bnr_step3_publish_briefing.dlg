*! BNR Briefing Step 3: Publish an approved briefing package
*! version 1.0.0, 4 August 2026
*! Thin interface to scripts/stata/briefings/bnr_step3_publish_briefing.do

VERSION 19.0
POSITION . . 520 430

LIST briefing_types
BEGIN
CVD incidence rates
CVD case-fatality
CVD length of stay
CVD mortality rates
END

DIALOG main, label("BNR Briefing Step 3: Publish approved package")
BEGIN
  TEXTBOX tx_intro 15 15 490 58, label("Publish the exact package approved in Briefing Step 2. The approval receipt, manifest and every staged file fingerprint are checked before copying begins.")

  GROUPBOX gb_briefing 15 85 490 58, label("Approved briefing")
  TEXT tx_briefing 30 110 120 ., label("Briefing type:")
  COMBOBOX cb_briefing 155 107 330 ., dropdownlist contents(briefing_types) nomemory

  GROUPBOX gb_input 15 155 490 96, label("Dataset release and briefing version")
  TEXT tx_year 30 182 105 ., label("Release year:")
  SPINNER ed_year 140 179 80 ., default(2024) min(2024) max(2100) nomemory error("Release year")
  TEXT tx_month 245 182 115 ., label("Release month:")
  SPINNER ed_month 365 179 60 ., default(1) min(1) max(12) nomemory error("Release month")
  TEXT tx_version 30 218 120 ., label("Briefing version:")
  SPINNER ed_version 155 215 70 ., default(1) min(1) max(99) nomemory error("Briefing version")

  GROUPBOX gb_confirm 15 265 490 70, label("Publication confirmation")
  CHECKBOX ck_publish 30 292 455 ., default(0) nomemory label("Publish this exact approved briefing package")

  TEXTBOX tx_boundary 20 350 480 35, label("Only manifested files cross the boundary. Quarto rendering, Git and GitHub remain separate actions.")
END

OK ok1, label("Publish")
CANCEL cancel1, label("Cancel")
HELP help1, view("help bnr_step3_publish_briefing")
RESET reset1

PROGRAM command
BEGIN
  require main.cb_briefing
  put "do $BNR_STATA/briefings/bnr_step3_publish_briefing.do "
  put /smartquote main.cb_briefing
  put " "
  put main.ed_year
  put " "
  put main.ed_month
  put " "
  put main.ed_version
  if main.ck_publish {
    put " publish"
  }
END
