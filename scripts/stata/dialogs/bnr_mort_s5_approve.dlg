*! BNR Mortality Step 5: Record human approval
*! Pass 4 monthly scope and reference review, 21 August 2026
*! Thin interface to mortality/bnr_mort_s5_approve.do

VERSION 19.0
POSITION . . 560 450

LIST release_years
BEGIN
2024
2025
2026
2027
2028
2029
2030
2031
2032
2033
2034
2035
2036
2037
2038
2039
2040
END

LIST release_months
BEGIN
01
02
03
04
05
06
07
08
09
10
11
12
END

LIST approver_roles
BEGIN
BNR Lead
BNR Analyst
END

DIALOG main, label("BNR CVD Mortality. Step 5 - approve mortality data release")
BEGIN
  TEXTBOX tx_intro 15 15 520 36, label("Step 5 approves the data package only after you have completed the review.")

  GROUPBOX gb_period 15 62 520 64, label("Step 4 release reviewed")
  TEXT tx_year 30 89 100 ., label("Release year:")
  COMBOBOX cb_year 140 85 90 ., dropdownlist contents(release_years) nomemory
  TEXT tx_month 285 89 105 ., label("Release month:")
  COMBOBOX cb_month 400 85 80 ., dropdownlist contents(release_months) nomemory

  GROUPBOX gb_approver 15 140 520 92, label("Authorised approver")
  TEXT tx_name 30 168 110 ., label("Full name:")
  EDIT ed_name 145 165 355 ., nomemory error("Approver name")
  TEXT tx_role 30 199 110 ., label("BNR role:")
  COMBOBOX cb_role 145 196 355 ., dropdownlist contents(approver_roles) nomemory

  GROUPBOX gb_confirm 15 246 520 165, label("Complete each review action, then tick")
  CHECKBOX ck_release     30 275 485 28, default(0) nomemory label("Quality Assurance: Step 3 and 4 QA checks PASS.") onclickon(program check_approval_boxes) onclickoff(main.bt_approve.disable)
  CHECKBOX ck_definitions 30 300 485 28, default(0) nomemory label("Metrics: results spot-checked.") onclickon(program check_approval_boxes) onclickoff(main.bt_approve.disable)
  CHECKBOX ck_disclosure  30 325 485 28, default(0) nomemory label("Suppression: protected rows checked.") onclickon(program check_approval_boxes) onclickoff(main.bt_approve.disable)
  CHECKBOX ck_candidate   30 350 485 28, default(0) nomemory label("Data release review completed.") onclickon(program check_approval_boxes) onclickoff(main.bt_approve.disable)
  CHECKBOX ck_ready       30 375 485 28, default(0) nomemory label("This data release is ready for Step 6.") onclickon(program check_approval_boxes) onclickoff(main.bt_approve.disable)

  BUTTON bt_approve 390 415 130 30, label("Record approval") onpush(program approve_package)
END

CANCEL cancel1, label("Cancel")
HELP help1, view("help bnr_mort_s5_approve")
RESET reset1

* Keep the approval button unavailable until the analyst has actively ticked
* every confirmation. The do-file repeats the checks and remains authoritative.
PROGRAM check_approval_boxes
BEGIN
  if main.ck_release & main.ck_definitions & main.ck_disclosure & main.ck_candidate & main.ck_ready {
    call main.bt_approve.enable
  }
  if !(main.ck_release & main.ck_definitions & main.ck_disclosure & main.ck_candidate & main.ck_ready) {
    call main.bt_approve.disable
  }
END

PROGRAM approve_package
BEGIN
  require main.cb_year
  require main.cb_month
  require main.ed_name
  require main.cb_role

  put "do $BNR_STATA/mortality/bnr_mort_s5_approve.do "
  put main.cb_year
  put " "
  put main.cb_month
  put " "
  put /smartquote main.ed_name
  put " "
  put /smartquote main.cb_role
  put " release definitions disclosure candidate ready"
  stata
  close
END
