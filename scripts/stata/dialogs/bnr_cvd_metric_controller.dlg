*! BNR CVD Step 4: Calculate metrics and create private staging packages
*! Thin interface to scripts/stata/monthly/bnr_cvd_metric_controller.do

VERSION 19.0
POSITION . . 470 405

DIALOG main, label("BNR Step 4: Calculate metrics")
BEGIN
  TEXTBOX tx_intro 15 15 440 35, label("Select the completed Step 3 release and the metric families authorised for calculation.")

  GROUPBOX gb_period 15 62 440 62, label("Step 3 release")
  TEXT tx_year      30 88 100 ., label("Release year:")
  SPINNER ed_year   140 85 85 ., default(2024) min(2024) max(2100) nomemory error("Release year")
  TEXT tx_month     260 88 95 ., label("Release month:")
  SPINNER ed_month  365 85 70 ., default(1) min(1) max(12) nomemory error("Release month")

  GROUPBOX gb_metrics 15 140 440 172, label("Metric families")
  CHECKBOX ck_burden 30 162 400 ., default(0) nomemory label("Burden - event counts and distributions")
  CHECKBOX ck_rate   30 184 400 ., default(0) nomemory label("Rate - planned") onclickoff(main.ck_rate.disable)
  CHECKBOX ck_outcome 30 206 400 ., default(0) nomemory label("Outcome - planned") onclickoff(main.ck_outcome.disable)
  CHECKBOX ck_hospital 30 228 400 ., default(0) nomemory label("Hospital use - planned") onclickoff(main.ck_hospital.disable)
  CHECKBOX ck_quality 30 250 400 ., default(0) nomemory label("Data quality - planned") onclickoff(main.ck_quality.disable)
  CHECKBOX ck_performance 30 272 400 ., default(0) nomemory label("Care performance - planned") onclickoff(main.ck_performance.disable)
  CHECKBOX ck_mortality 30 294 400 ., default(0) nomemory label("Mortality - planned; separate input required") onclickoff(main.ck_mortality.disable)

  CHECKBOX ck_replace 20 330 430 ., default(0) nomemory label("Authorise replacement of the selected staging package")
  TEXTBOX tx_boundary 20 356 430 28, label("Exact values remain in private staging. Step 5 completes suppression review.")
END

OK ok1, label("Run metrics")
CANCEL cancel1, label("Cancel")
HELP help1, view("help bnr_cvd_metric_controller")
RESET reset1

PROGRAM command
BEGIN
  put "do $BNR_STATA/monthly/bnr_cvd_metric_controller.do "
  put main.ed_year
  put " "
  put main.ed_month
  if main.ck_burden {
    put " burden"
  }
  if main.ck_replace {
    put " replace"
  }
END
