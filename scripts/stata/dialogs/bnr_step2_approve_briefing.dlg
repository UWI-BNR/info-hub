*! BNR Briefing Step 2: Review and approve a staged package
*! version 1.1.1, 4 August 2026
*! Thin interface to scripts/stata/briefings/bnr_step2_approve_briefing.do

VERSION 19.0
POSITION . . 540 725

LIST briefing_types
BEGIN
CVD incidence rates
CVD case-fatality
CVD length of stay
CVD mortality rates
Ad-hoc briefing
END

* One interface action for each briefing type, in the same order as the list.
* Routine types must never accept an ad-hoc package ID.
LIST briefing_type_actions
BEGIN
script select_routine_briefing
script select_routine_briefing
script select_routine_briefing
script select_routine_briefing
script select_ad_hoc_briefing
END

LIST approver_roles
BEGIN
BNR Lead
BNR Analyst
BNR Developer
END

DIALOG main, label("BNR Briefing Step 2: Review and approve")
BEGIN
  TEXTBOX tx_intro 15 15 510 45, label("Record the completed human review of a private Step 1 package. This action creates an approval receipt and manifest; it does not publish files.")

  GROUPBOX gb_briefing 15 72 510 96, label("Staged briefing")
  TEXT tx_briefing 30 97 120 ., label("Briefing type:")
  COMBOBOX cb_briefing 155 94 350 ., dropdownlist contents(briefing_types) nomemory onselchangelist(briefing_type_actions)
  TEXT tx_package 30 133 120 ., label("Ad-hoc package ID:")
  EDIT ed_package 155 130 350 ., nomemory error("Ad-hoc package ID")

  GROUPBOX gb_input 15 180 510 96, label("Routine briefing selection")
  TEXT tx_year 30 207 105 ., label("Release year:")
  SPINNER ed_year 140 204 80 ., default(2024) min(2024) max(2100) nomemory error("Release year")
  TEXT tx_month 245 207 115 ., label("Release month:")
  SPINNER ed_month 365 204 60 ., default(1) min(1) max(12) nomemory error("Release month")
  TEXT tx_version 30 243 120 ., label("Briefing version:")
  SPINNER ed_version 155 240 70 ., default(1) min(1) max(99) nomemory error("Briefing version")

  GROUPBOX gb_approver 15 288 510 88, label("Approver")
  TEXT tx_name 30 314 115 ., label("Full name:")
  EDIT ed_name 155 311 350 ., nomemory error("Approver name")
  TEXT tx_role 30 345 115 ., label("Role:")
  COMBOBOX cb_role 155 342 350 ., dropdownlist contents(approver_roles) nomemory

  GROUPBOX gb_checks 15 388 510 190, label("Required review confirmations")
  CHECKBOX ck_source 30 413 475 ., default(0) nomemory label("Correct source dataset, release and reporting period checked") onclickon(program check_approval_boxes) onclickoff(main.bt_approve.disable)
  CHECKBOX ck_results 30 443 475 ., default(0) nomemory label("Analysis, results, datasets, workbook and figures checked") onclickon(program check_approval_boxes) onclickoff(main.bt_approve.disable)
  CHECKBOX ck_disclosure 30 473 475 ., default(0) nomemory label("Manual disclosure review completed, including automated flags") onclickon(program check_approval_boxes) onclickoff(main.bt_approve.disable)
  CHECKBOX ck_labels 30 503 475 ., default(0) nomemory label("Titles, labels, metadata, notes and limitations checked") onclickon(program check_approval_boxes) onclickoff(main.bt_approve.disable)
  CHECKBOX ck_complete 30 533 475 ., default(0) nomemory label("Package is complete and ready for publication") onclickon(program check_approval_boxes) onclickoff(main.bt_approve.disable)

  TEXTBOX tx_boundary 20 593 500 45, label("For ad-hoc work, enter the exact staging package ID; the routine fields are ignored. All five boxes are required.")

  BUTTON bt_approve 405 655 120 28, label("Approve") onpush(program approve_package)
END


* Selecting a routine type clears and locks the field.  This prevents a stale
* ad-hoc ID from appearing relevant to a routine briefing.
SCRIPT select_routine_briefing
BEGIN
  main.ed_package.setvalue ""
  main.ed_package.disable
END


* An exact staging package ID is required only for an ad-hoc briefing.
SCRIPT select_ad_hoc_briefing
BEGIN
  main.ed_package.enable
  main.ed_package.setfocus
END

CANCEL cancel1, label("Cancel")
HELP help1, view("help bnr_step2_approve_briefing")
RESET reset1


* Check the five boxes whenever one of them is selected.
* The Approve button is enabled only when every box is selected.
PROGRAM check_approval_boxes
BEGIN
  if main.ck_source & main.ck_results & main.ck_disclosure & main.ck_labels & main.ck_complete {
    call main.bt_approve.enable
  }
  if !(main.ck_source & main.ck_results & main.ck_disclosure & main.ck_labels & main.ck_complete) {
    call main.bt_approve.disable
  }
END


* Run the ordinary Step 2 controller when the enabled button is pressed.
* The controller repeats all five checks and remains the final safeguard.
PROGRAM approve_package
BEGIN
  require main.cb_briefing
  require main.ed_name
  require main.cb_role
  put "do $BNR_STATA/briefings/bnr_step2_approve_briefing.do "
  put /smartquote main.cb_briefing
  put " "
  put main.ed_year
  put " "
  put main.ed_month
  put " "
  put main.ed_version
  put " "
  put /smartquote main.ed_name
  put " "
  put /smartquote main.cb_role
  put " source results disclosure labels complete"
  put " "
  put /smartquote main.ed_package
  stata
  close
END
