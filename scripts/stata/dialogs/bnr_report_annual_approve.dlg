*! BNR annual CVD report candidate approval
*! version 0.1.0, 2 September 2026
VERSION 19.0
POSITION . . 520 430

LIST approval_roles
BEGIN
BNR Lead
BNR Analyst
BNR Developer
END

DIALOG main, label("BNR: Approve annual CVD report candidate")
BEGIN
  TEXTBOX tx_intro 15 15 490 54, label("Record approval only after the candidate PDF and landing-page source have been reviewed. Approval binds their exact file fingerprints and does not publish the report.")
  GROUPBOX gb_report 15 84 490 68, label("Candidate")
  TEXT tx_year 30 112 95 ., label("Report year:")
  SPINNER ed_year 135 109 75 ., default(2025) min(2024) max(2100) nomemory error("Report year")
  TEXT tx_version 270 112 65 ., label("Version:")
  SPINNER ed_version 340 109 55 ., default(1) min(1) max(99) nomemory error("Report version")
  GROUPBOX gb_approver 15 168 490 105, label("Authorised approver")
  TEXT tx_name 30 198 95 ., label("Full name:")
  EDIT ed_name 135 195 330 ., nomemory error("Approver full name")
  TEXT tx_role 30 236 95 ., label("Role:")
  COMBOBOX cb_role 135 232 180 ., dropdownlist contents(approval_roles) nomemory
  TEXTBOX tx_boundary 20 298 470 46, label("The approval receipt is written to the staged candidate's public_ready area. It is a workflow-control record, not a public website file.")
END

OK ok1, label("Approve candidate")
CANCEL cancel1, label("Cancel")
RESET reset1

PROGRAM command
BEGIN
  require main.ed_name
  require main.cb_role
  put "do $BNR_STATA/reporting/bnr_report_annual_approve.do "
  put main.ed_year
  put " "
  put main.ed_version
  put " "
  put `"""'
  put main.ed_name
  put `"""'
  put " "
  put `"""'
  put main.cb_role
  put `"""'
END
