*! BNR CVD Step 1 confidential cumulative dataset dialog
*! version 1.0.0, 21 July 2026
*! Thin interface to scripts/stata/monthly/bnr_cvd_prepare_confidential.do

VERSION 19.0
POSITION . . 450 270

DIALOG main, label("BNR CVD - Step 1: confidential cumulative dataset")
BEGIN
    TEXTBOX intro 15 15 420 42, label("Builds one confidential cumulative CVD dataset by appending the selected post-2023 REDCap release to the frozen 2009-2023 dataset.")

    GROUPBOX period 15 70 420 86, label("Selected cumulative release")
    TEXT year_label 30 95 105 ., label("Release year:")
    SPINNER year 145 92 90 ., default(2024) min(2024) max(2100) nomemory error("Release year")

    TEXT month_label 30 127 105 ., label("Release month:")
    SPINNER month 145 124 90 ., default(1) min(1) max(12) nomemory error("Release month")
    TEXT month_note 245 127 160 ., label("1 = Jan; 12 = Dec")

    TEXTBOX output_note 25 180 400 52, label("The command derives the Step 0 input automatically. It creates only a confidential dataset, receipt and log; it does not create metric inputs, staging, public or website files.")
END

OK ok1, label("Build dataset")
CANCEL cancel1, label("Cancel")
HELP help1, view("help bnr_cvd_prepare_confidential")
RESET reset1

PROGRAM command
BEGIN
    put "do $BNR_STATA/monthly/bnr_cvd_prepare_confidential.do "
    put main.year
    put " "
    put main.month
END
