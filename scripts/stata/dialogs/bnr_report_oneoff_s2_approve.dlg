*! BNR one-off CVD report Step 2: approve candidate
*! version 0.1.0, 2 September 2026
VERSION 19.0
POSITION . . 560 470

LIST approval_roles
BEGIN
BNR Lead
BNR Analyst
END

DIALOG main, label("BNR One-off Report. Step 2 - approve report")
BEGIN
  TEXTBOX tx_intro 15 15 530 52, label("Step 2 approves the report after review.")
  GROUPBOX gb_report 15 82 530 70, label("Candidate")
  TEXT tx_study 30 111 90 ., label("Study ID:")
  EDIT ed_study 130 108 250 ., nomemory error("Study ID")
  TEXT tx_version 405 111 65 ., label("Version:")
  SPINNER ed_version 475 108 55 ., default(1) min(1) max(99) nomemory error("Report version")
  GROUPBOX gb_approver 15 168 530 105, label("Authorised approver")
  TEXT tx_name 30 198 95 ., label("Full name:")
  EDIT ed_name 135 195 350 ., nomemory error("Approver full name")
  TEXT tx_role 30 236 95 ., label("Role:")
  COMBOBOX cb_role 135 232 190 ., dropdownlist contents(approval_roles) nomemory
  GROUPBOX gb_review 15 289 530 126, label("Required review confirmations")
  CHECKBOX ck_candidate 30 316 500 ., default(0) nomemory label("I reviewed the complete candidate PDF, landing page and metadata") onclickon(program check_approval_boxes) onclickoff(main.bt_approve.disable)
  CHECKBOX ck_disclosure 30 346 500 ., default(0) nomemory label("I completed and recorded disclosure review") onclickon(program check_approval_boxes) onclickoff(main.bt_approve.disable)
  CHECKBOX ck_ready 30 376 500 ., default(0) nomemory label("I confirm this exact candidate is ready for public release") onclickon(program check_approval_boxes) onclickoff(main.bt_approve.disable)
  BUTTON bt_approve 390 425 130 30, label("Record approval") onpush(program approve_package)
END

CANCEL cancel1, label("Cancel")
RESET reset1

* Keep the approval button unavailable until the analyst has actively ticked
* every confirmation. The do-file repeats the checks and remains authoritative.
PROGRAM check_approval_boxes
BEGIN
  if main.ck_candidate & main.ck_disclosure & main.ck_ready {
    call main.bt_approve.enable
  }
  if !(main.ck_candidate & main.ck_disclosure & main.ck_ready) {
    call main.bt_approve.disable
  }
END

PROGRAM command
BEGIN
  require main.ed_study
  require main.ed_name
  require main.cb_role
  put "do $BNR_STATA/reporting/bnr_report_oneoff_s2_approve.do "
  put main.ed_study
  put " "
  put main.ed_version
  put " "
  put `"""'
  put main.ed_name
  put `"""'
  put " "
  put `"""'
  put main.cb_role
  put `"""'
  if main.ck_candidate {
    put " candidate"
  }
  if !main.ck_candidate {
    put " missing"
  }
  if main.ck_disclosure {
    put " disclosure"
  }
  if !main.ck_disclosure {
    put " missing"
  }
  if main.ck_ready {
    put " ready"
  }
  if !main.ck_ready {
    put " missing"
  }
END
