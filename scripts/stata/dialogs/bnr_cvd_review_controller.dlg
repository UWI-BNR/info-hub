*! BNR CVD Step 5: Prepare review package or record approval
*! version 1.4.0, 23 July 2026
*! Thin interface to scripts/stata/monthly/bnr_cvd_review_controller.do

VERSION 19.0
POSITION . . 500 630

LIST approver_roles
BEGIN
BNR Lead
BNR Analyst
BNR Statistician
END

DIALOG main, label("BNR Step 5: Review and approval")
BEGIN
  TEXTBOX tx_intro 15 15 470 58, label("Prepare the private review materials. After completing the human review, run Step 5 again and select approval. Future multi-family sessions will keep a separate approval record for each family.")

  GROUPBOX gb_period 15 82 470 62, label("Step 4 release")
  TEXT tx_year      30 108 100 ., label("Release year:")
  SPINNER ed_year   140 105 85 ., default(2024) min(2024) max(2100) nomemory error("Release year")
  TEXT tx_month     270 108 95 ., label("Release month:")
  SPINNER ed_month  380 105 70 ., default(1) min(1) max(12) nomemory error("Release month")

  GROUPBOX gb_family 15 158 470 185, label("Metric families")
  CHECKBOX ck_burden 30 181 430 ., default(1) nomemory label("Burden - event counts and distributions")
  CHECKBOX ck_incidence 30 203 430 ., default(0) nomemory label("Incidence and rates - planned") onclickoff(main.ck_incidence.disable)
  CHECKBOX ck_case_fatality 30 225 430 ., default(0) nomemory label("Case fatality - planned") onclickoff(main.ck_case_fatality.disable)
  CHECKBOX ck_los 30 247 430 ., default(0) nomemory label("Length of stay / hospital use - planned") onclickoff(main.ck_los.disable)
  CHECKBOX ck_quality 30 269 430 ., default(0) nomemory label("Data quality - planned") onclickoff(main.ck_quality.disable)
  CHECKBOX ck_performance 30 291 430 ., default(0) nomemory label("Care performance - planned") onclickoff(main.ck_performance.disable)
  CHECKBOX ck_mortality 30 313 430 ., default(0) nomemory label("Mortality - planned; separate deaths input required") onclickoff(main.ck_mortality.disable)

  GROUPBOX gb_action 15 354 470 78, label("Action")
  RADIO rb_prepare 30 377 430 ., first default(1) nomemory label("Prepare the review package")
  RADIO rb_approve 30 402 430 ., last nomemory label("Record approval after completing the review")

  GROUPBOX gb_approver 15 444 470 88, label("Required only when recording approval")
  TEXT tx_name 30 470 110 ., label("Approver name:")
  EDIT ed_name 145 467 320 ., nomemory error("Approver name")
  TEXT tx_role 30 500 110 ., label("Approver role:")
  COMBOBOX cb_role 145 497 320 ., dropdownlist contents(approver_roles) nomemory

  CHECKBOX ck_replace 20 544 460 ., default(0) nomemory label("Authorise replacement when preparing this review package")
  TEXTBOX tx_boundary 20 572 460 26, label("public_ready is created only by approval. Step 5 creates no public or website files.")
END

OK ok1, label("Run Step 5")
CANCEL cancel1, label("Cancel")
HELP help1, view("help bnr_cvd_review_controller")
RESET reset1

PROGRAM command
BEGIN
  put "do $BNR_STATA/monthly/bnr_cvd_review_controller.do "
  put main.ed_year
  put " "
  put main.ed_month
  put " burden "
  if main.rb_prepare {
    put "prepare"
    if main.ck_replace {
      put " replace"
    }
  }
  if main.rb_approve {
    require main.ed_name
    put "approve "
    put /smartquote main.ed_name
    put " "
    put /smartquote main.cb_role
  }
END
