*! BNR annual CVD report publication
*! version 0.1.0, 2 September 2026
VERSION 19.0
POSITION . . 520 360

DIALOG main, label("BNR: Publish approved annual CVD report")
BEGIN
  TEXTBOX tx_intro 15 15 490 54, label("Publish the exact approved annual-report candidate. This verifies its staged public_ready receipt before promoting the PDF and landing page to public and website paths.")
  GROUPBOX gb_report 15 84 490 68, label("Approved candidate")
  TEXT tx_year 30 112 95 ., label("Report year:")
  SPINNER ed_year 135 109 75 ., default(2025) min(2024) max(2100) nomemory error("Report year")
  TEXT tx_version 270 112 65 ., label("Version:")
  SPINNER ed_version 340 109 55 ., default(1) min(1) max(99) nomemory error("Report version")
  GROUPBOX gb_protection 15 168 490 62, label("Publication protection")
  CHECKBOX ck_replace 30 194 450 ., default(0) nomemory label("Replace the currently rendered annual report for this year")
  TEXTBOX tx_boundary 20 250 470 42, label("This publishes approved files only. It does not render Quarto, commit changes, push to GitHub or deploy the website.")
END

OK ok1, label("Publish annual report")
CANCEL cancel1, label("Cancel")
RESET reset1

PROGRAM command
BEGIN
  put "do $BNR_STATA/reporting/bnr_report_annual_publish.do "
  put main.ed_year
  put " "
  put main.ed_version
  if main.ck_replace {
    put " replace"
  }
END
