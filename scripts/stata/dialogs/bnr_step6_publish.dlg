*! BNR CVD Step 6: publish an approved combined CVD package
VERSION 19.0
POSITION . . 500 220
DIALOG main, label("BNR CVD Events. Step 6 - publish approved outputs")
BEGIN
  TEXTBOX tx_intro 15 15 470 50, label("Step 6 verifies the approved CVD data package, publishes it, and creates a ZIP of all files (for website download).")
  GROUPBOX gb_period 15 82 470 68, label("Approved Step 5 CVD release")
  TEXT tx_year 30 110 100 ., label("Year:")
  SPINNER ed_year 140 107 85 ., default(2024) min(2024) max(2100) nomemory error("Release year")
  TEXT tx_month 270 110 95 ., label("Month:")
  SPINNER ed_month 380 107 70 ., default(1) min(1) max(12) nomemory error("Release month")
  CHECKBOX ck_replace 30 180 430 ., default(0) nomemory label("Authorise replacement")
END
OK ok1, label("Run Step 6")
CANCEL cancel1, label("Cancel")
HELP help1, view("help bnr_step6_publish")
RESET reset1
PROGRAM command
BEGIN
  put "do $BNR_STATA/monthly/bnr_step6_publish.do "
  put main.ed_year
  put " "
  put main.ed_month
  if main.ck_replace {
    put " replace"
  }
END
