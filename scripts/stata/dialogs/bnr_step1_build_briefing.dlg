*! BNR Briefing Step 1: Build a private briefing review package
*! version 1.2.0, 3 August 2026
*! Thin interface to scripts/stata/briefings/bnr_step1_build_briefing.do

VERSION 19.0
POSITION . . 520 410

LIST briefing_types
BEGIN
CVD incidence rates
CVD case-fatality
CVD length of stay
CVD mortality rates
END

DIALOG main, label("BNR Briefing Step 1: Build review package")
BEGIN
  TEXTBOX tx_intro 15 15 490 48, label("Run one briefing analysis and create a private staging package for human review. This action does not approve, publish, or render the briefing.")

  GROUPBOX gb_briefing 15 76 490 58, label("Briefing")
  TEXT tx_briefing 30 101 120 ., label("Briefing type:")
  COMBOBOX cb_briefing 155 98 330 ., dropdownlist contents(briefing_types) nomemory

  GROUPBOX gb_input 15 148 490 100, label("Dataset release")
  TEXT tx_year 30 175 105 ., label("Release year:")
  SPINNER ed_year 140 172 80 ., default(2024) min(2024) max(2100) nomemory error("Release year")
  TEXT tx_month 245 175 115 ., label("Release month:")
  SPINNER ed_month 365 172 60 ., default(1) min(1) max(12) nomemory error("Release month")
  TEXTBOX tx_input_note 30 204 455 30, label("The briefing analyses complete calendar years through the end of the previous year. Step 3 dataset version 01 is used automatically.")

  GROUPBOX gb_release 15 262 490 58, label("Briefing release")
  TEXT tx_briefing_version 30 287 190 ., label("Briefing version:")
  SPINNER ed_briefing_version 225 284 70 ., default(1) min(1) max(99) nomemory error("Briefing version")

  CHECKBOX ck_replace 20 342 480 ., default(0) nomemory label("Authorise replacement of this existing unapproved staging package")
END

OK ok1, label("Run analysis")
CANCEL cancel1, label("Cancel")
HELP help1, view("help bnr_step1_build_briefing")
RESET reset1

PROGRAM command
BEGIN
  require main.cb_briefing
  put "do $BNR_STATA/briefings/bnr_step1_build_briefing.do "
  put /smartquote main.cb_briefing
  put " "
  put main.ed_year
  put " "
  put main.ed_month
  put " "
  put main.ed_briefing_version
  if main.ck_replace {
    put " replace"
  }
END
